# NextAuth Configuration
# Generate a random secret with: openssl rand -base64 32
AUTH_SECRET=

# Google OAuth 2.0 Credentials
# Get these from Google Cloud Console (https://console.cloud.google.com)
# See GOOGLE_AUTH.md for detailed setup instructions
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Supabase Postgres (server only; never NEXT_PUBLIC_)
SUPABASE_PASSWORD_DB=
SUPABASE_DB_HOST=aws-1-us-west-2.pooler.supabase.com
SUPABASE_DB_PORT=6543
SUPABASE_DB_USER=postgres.ntbiypfuelktsjfceqqu
# Preview must explicitly use preview_lists; Production defaults to public.
SUPABASE_DB_SCHEMA=public

# Optional invitation emails, server-only (leave unset to use in-app invitations)
RESEND_API_KEY=
INVITATION_FROM=
APP_URL=

# Optional Gmail SMTP alternative (server only; never commit values)
GMAIL_USER_EMAIL=
GMAIL_APP_PASSWORD=

# Google ID token is verified by Supabase Auth; configure its Google provider.
SUPABASE_AUTH_URL=
SUPABASE_AUTH_PUBLISHABLE_KEY=

# ChatGPT MCP (public URL must end in /mcp)
MCP_SERVER_URL=
# OAuth client IDs registered in Supabase for the ChatGPT connector
MCP_OAUTH_ALLOWED_CLIENT_IDS=
